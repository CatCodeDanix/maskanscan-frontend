# Database connection
DATABASE_URL=postgresql://user:password@localhost:5432/maskanscan

# Canonical domain
NEXT_PUBLIC_APP_URL=https://maskanscan.ir

# Real estate data scraper & ingestion backend service
BACKEND_URL=http://localhost:9000

# Better-Auth secret & canonical auth URL
BETTER_AUTH_SECRET=your-random-32-byte-secret-key
BETTER_AUTH_URL=https://maskanscan.ir

# Transactional emails via Resend (Optional)
RESEND_API_KEY=re_123456789
EMAIL_FROM=notifications@maskanscan.ir
